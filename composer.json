{
    "name": "marrow/framework",
    "description": "Marrow is a PHP 8.2+ framework designed for modular, scalable, and testable applications.",
    "keywords": [
        "framework",
        "hmvc",
        "modular",
        "php",
        "tailwind",
        "module",
        "laravel",
        "marrow"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aure Dulvresse",
            "email": "marrow.framework@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.4",
        "fakerphp/faker": "^1.23",
        "firebase/php-jwt": "^7.0",
        "league/flysystem": "^3.29",
        "monolog/monolog": "^3.10",
        "psy/psysh": "^0.12.23",
        "symfony/cache": "^7.0",
        "symfony/console": "^7.0",
        "symfony/http-client": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/mailer": "^7.0",
        "symfony/process": "^7.0",
        "symfony/rate-limiter": "^7.0",
        "symfony/var-dumper": "^7.0",
        "twig/twig": "^3.27",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "league/flysystem-aws-s3-v3": "^3.29",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-apcu": "Faster in-memory cache and rate limiting",
        "league/flysystem-aws-s3-v3": "S3 filesystem disk support",
        "predis/predis": "Redis cache and queue backend"
    },
    "autoload": {
        "psr-4": {
            "Marrow\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Marrow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=256M"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.0"
        }
    }
}
